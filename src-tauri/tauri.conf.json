{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTE Control",
  "version": "1.0.0",
  "identifier": "com.teaminternational.ztecontrol",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ZTE Control — Modem Rotator",
        "width": 1200,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
